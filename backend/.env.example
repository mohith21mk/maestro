# Application Configuration
APP_NAME=POWER HOUSE Backend API
ENVIRONMENT=development
DEBUG=true
API_V1_STR=/api/v1

# Security Key (Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))")
# Required in production (minimum 32 characters); dev placeholder allowed ONLY in local development
SECRET_KEY=powerhouse-dev-only-secret-key-do-not-use-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Configuration
# Local Development (SQLite):
DATABASE_URL=sqlite:///./powerhouse.db
# Production (Render Managed PostgreSQL):
# DATABASE_URL=postgresql://user:password@host.oregon-postgres.render.com/powerhouse_db

# CORS Configuration (comma-separated origins)
# Local Development:
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Production (Add your deployed Netlify frontend domain):
# BACKEND_CORS_ORIGINS=https://powerhouse-app.netlify.app
